    "thinking-orbs": "0.3.2"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "22.20.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  }
